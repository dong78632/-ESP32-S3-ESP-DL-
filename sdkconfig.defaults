# ESP-DL classic models need C++ exceptions for recoverable STL failures.
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=4096

# Dynamic frequency scaling and automatic light sleep (ESP-IDF 5.0.x).
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# Verify Flash/PSRAM type and frequency against the actual purchased module.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y

# Two face models require more app space than the small default app partition.
# This table fits a 4 MB Flash part; select actual Flash size in menuconfig.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Bound MQTT's own retry lifetime as well as the application's alert queue.
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_OUTBOX_EXPIRED_TIMEOUT_MS=300000
CONFIG_MQTT_REPORT_DELETED_MESSAGES=y
